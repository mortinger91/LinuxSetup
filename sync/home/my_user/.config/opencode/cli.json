{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "session.toggle.scrollbar": "<leader>k",
    "agent.cycle": "ctrl+i",
    "agent.cycle.reverse": "ctrl+shift+i",
    "session.line.up": "up",
    "session.line.down": "down",
    "session.message.next": "ctrl+l",
    "session.message.previous": "ctrl+o",
    "prompt.history.previous": "alt+up",
    "prompt.history.next": "alt+down"
  },
  "plugins": [
    "./tui-plugins/scroll-boost.js"
  ],
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true,
  "prompt": {
    "paste": "full"
  }
}
